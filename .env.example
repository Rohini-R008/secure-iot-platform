# Copy this file to .env and change the secrets before running.
# docker-compose and the processor both read these values.
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change-me-to-a-strong-password
INFLUXDB_ORG=secure-iot
INFLUXDB_BUCKET=telemetry
INFLUXDB_ADMIN_TOKEN=change-me-to-a-long-random-token
INFLUXDB_URL=http://localhost:8086
INFLUXDB_AUDIT_BUCKET=audit
# Signing key for session cookies — generate your own for .env
WEBAPP_SECRET_KEY=change-me-to-a-long-random-string